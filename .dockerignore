# .dockerignore TIDAK mengenal komentar di ujung baris — seluruh baris dibaca
# sebagai pola. Tulis komentar di barisnya sendiri.

# Dependencies (dipasang di dalam container)
/node_modules
/vendor

# Hasil build & berkas server lokal
/public/build
/public/hot
/public/storage

# Isi storage lokal — termasuk storage/app/gcs yang berisi KUNCI AKUN LAYANAN.
# Di Cloud Run aplikasi memakai akun layanan service-nya, bukan berkas kunci.
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/storage/*.key

# Cache konfigurasi dari mesin lokal bisa membawa kredensial basis data lokal.
/bootstrap/cache/*.php

# Berkas lingkungan (SANGAT PENTING). .env.example JANGAN di-ignore — dipakai saat build.
.env
.env.*
!.env.example
*[Ee][Nn][Vv]*.txt
auth.json
*.p12
*.pem

# Pengujian & alat pengembangan — tidak dibutuhkan image produksi
/tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
npm-debug.log
yarn-error.log
docker-compose.yml

# Dokumen, arsip, IDE, git
/docs
*.zip
*.7z
*.rar
/*.sql
/.claude
CLAUDE.md
/.fleet
/.idea
/.vscode
.DS_Store
.git
.gitignore
.gitattributes
.dockerignore
