APP_NAME=Laravel

# Versi aplikasi yang ditampilkan di kaki halaman dan layar masuk.
# Kosongkan untuk memakai bawaan 1.0.0 (lihat config/app.php).
APP_VERSION=1.0.1
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Khusus local/testing: akun kandidat baru langsung terverifikasi.
# Di production fitur tetap dipaksa nonaktif oleh guard pada backend.
CAREER_AUTO_VERIFY_EMAIL=false
CAREER_DIVISI_INFO_ENABLED=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database PUBLIK (zona luar) — bukan database admin.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
# sync = penerbit Outbox langsung jalan sesudah request (lokal).
# cloudtasks = Google Cloud Tasks, queue wcp-terbit (Cloud Run).
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ═══════════════════════════════════════════════════════════════════════════
# META HALAMAN & KARTU PRATINJAU TAUTAN  (config/seo.php)
# ═══════════════════════════════════════════════════════════════════════════
#
# Yang menentukan tampilan tautan saat dibagikan ke WhatsApp/LinkedIn: logo,
# judul, dan deskripsinya. SELURUH URL (og:url, og:image, canonical) dibangun
# dari host permintaan, jadi TIDAK ADA env berisi domain di sini — lokal,
# staging, dan produksi memakai berkas yang sama tanpa diubah.

# Akhiran judul tab: "{Nama Halaman} | Careers Evo Group".
SEO_SITE_NAME="Careers Evo Group"

# Boleh diindeks mesin pencari? Kosongkan untuk memakai bawaan
# (true HANYA saat APP_ENV=production). Staging WAJIB false supaya tidak
# bersaing dengan produksi di hasil Google — pratinjau WhatsApp tetap jalan.
# SEO_INDEXABLE=false

# Kartu pratinjau 1200x630, relatif terhadap public/.
# SEO_IMAGE=og/og-default.jpg

# Judul & deskripsi halaman depan (bawaannya sudah terisi di config/seo.php).
# SEO_DEFAULT_TITLE="Karier Bersama EVO Group"
# SEO_DEFAULT_DESCRIPTION="..."

# Akun sosial resmi — dipakai JSON-LD "sameAs" dan kartu X/Twitter.
# SEO_TWITTER_SITE=@evogroup
# SEO_SOCIAL_INSTAGRAM=https://www.instagram.com/...
# SEO_SOCIAL_LINKEDIN=https://www.linkedin.com/company/...

# Kode verifikasi dari Google Search Console (Setelan → Verifikasi kepemilikan
# → Tag HTML). Salin NILAI content="..."-nya saja, bukan seluruh tagnya.
# Dibiarkan kosong = tagnya tidak dicetak sama sekali.
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=

# Wilayah — menegaskan lowongan di situs ini berada di Sumatera Selatan.
SEO_GEO_PLACE="Palembang"
SEO_GEO_REGION="Sumatera Selatan"
SEO_GEO_POSITION="-2.976074, 104.775429"

# Nama lain & anak usaha. Dipisah koma. Google memakainya menyatukan entitas —
# tanpa ini "EVO", "PT EVO Group", dan tiap anak usaha dianggap berbeda.
# SEO_ALTERNATE_NAMES="PT EVO Group, EVO, EVO Group Palembang"
# SEO_SUB_ORGANIZATIONS="PT Evo Manufacturing Indonesia, PT Evo Nusa Bersaudara"
# SEO_AREA_SERVED="Palembang, Sumatera Selatan, Sumatera, Indonesia"

# ── PENYAPU OUTBOX (Cloud Scheduler → POST /api/tugas/terbit-outbox) ───────────
# Nilai header X-Tugas-Token di job Cloud Scheduler. Setara kredensial: kosong /
# kurang dari 32 karakter = ditolak (gagal-tertutup). Buat BARU per lingkungan,
# dan JANGAN sama dengan TUGAS_TOKEN admin:
#   php -r "echo bin2hex(random_bytes(32));"
TUGAS_TOKEN=
